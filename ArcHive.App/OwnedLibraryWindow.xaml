<Window x:Class="ArcHive.App.OwnedLibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:ArcHive.Core;assembly=ArcHive.Core" Title="Import owned games" Width="800" Height="680" MinWidth="600" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#080D0B" Foreground="#E1F0E6" FontFamily="Segoe UI"><DockPanel Margin="26">
 <StackPanel DockPanel.Dock="Top"><TextBlock Text="Import Owned Games" FontSize="26"/><TextBlock Text="Preview owned titles before adding them. Imported games are marked Not Installed; they never download or launch anything automatically. Existing games are preserved." TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,12"/><StackPanel x:Name="Actions"><ComboBox x:Name="Provider" SelectedIndex="0" SelectionChanged="ProviderChanged"><ComboBoxItem Content="Steam"/><ComboBoxItem Content="GOG"/></ComboBox><TextBlock Text="SteamID64 (for optional Steam API lookup)" Margin="0,12,0,0"/><TextBox x:Name="SteamId" AutomationProperties.Name="SteamID64"/><WrapPanel><Button x:Name="Fetch" Content="Find Steam Games" Click="FetchSteam"/><Button Content="Import Library JSON…" Click="ImportFile"/><Button Content="Select All New Games" Click="SelectAll"/></WrapPanel></StackPanel><TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,10"/></StackPanel>
 <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right"><Button x:Name="ApplyButton" Content="Add selected games" Click="Apply" IsEnabled="False"/><Button Content="{x:Static core:UiText.Cancel}" IsCancel="True"/></WrapPanel>
 <ListBox x:Name="Games" SelectionMode="Extended" AutomationProperties.Name="Owned games to import"/>
</DockPanel></Window>
