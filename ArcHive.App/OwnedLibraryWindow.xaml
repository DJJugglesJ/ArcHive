<Window x:Class="ArcHive.App.OwnedLibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Import owned games" Width="800" Height="680" MinWidth="600" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#080D0B" Foreground="#E1F0E6" FontFamily="Segoe UI"><DockPanel Margin="26">
 <StackPanel DockPanel.Dock="Top"><TextBlock Text="Bring your library together" FontSize="26"/><TextBlock Text="Preview owned titles before adding them. Imported entries are marked Not installed; they never download or launch anything automatically. Existing entries are preserved." TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,12"/><StackPanel x:Name="Actions"><ComboBox x:Name="Provider" SelectedIndex="0" SelectionChanged="ProviderChanged"><ComboBoxItem Content="Steam"/><ComboBoxItem Content="GOG"/></ComboBox><TextBlock Text="SteamID64 (for optional Steam API lookup)" Margin="0,12,0,0"/><TextBox x:Name="SteamId" AutomationProperties.Name="SteamID64"/><WrapPanel><Button x:Name="Fetch" Content="Fetch visible Steam library" Click="FetchSteam"/><Button Content="Import library JSON" Click="ImportFile"/><Button Content="Select all new titles" Click="SelectAll"/></WrapPanel></StackPanel><TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,10"/></StackPanel>
 <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right"><Button x:Name="ApplyButton" Content="Add selected games" Click="Apply" IsEnabled="False"/><Button Content="Cancel" IsCancel="True"/></WrapPanel>
 <ListBox x:Name="Games" SelectionMode="Extended" AutomationProperties.Name="Owned games to import"/>
</DockPanel></Window>
