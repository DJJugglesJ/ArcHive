<Window x:Class="ArcHive.App.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:ArcHive.Core;assembly=ArcHive.Core" Title="About ArcHive" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#080D0B" Foreground="#E1F0E6" FontFamily="Segoe UI" Icon="{StaticResource ArcHiveIcon}">
 <StackPanel Margin="32">
  <Image x:Name="AboutIcon" Width="80" Height="80" HorizontalAlignment="Left" Margin="0,0,0,18"/>
  <TextBlock Text="ArcHive" FontSize="30" FontWeight="SemiBold"/>
  <TextBlock x:Name="VersionLabel" Foreground="#B3FFD0" Margin="0,8,0,20"/>
  <TextBlock x:Name="DeveloperLabel" Margin="0,0,0,8"/>
  <TextBlock x:Name="CopyrightLabel" TextWrapping="Wrap" Foreground="#8FAA99"/>
  <TextBlock Text="{x:Static core:UiText.Tagline}" Margin="0,20,0,22" Foreground="#8FAA99"/>
  <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="90"/>
 </StackPanel>
</Window>
