<Application x:Class="ArcHive.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcHive.App" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <local:CompactPathConverter x:Key="CompactPath"/>
  <!-- Exact pixels from the user-approved brand board; no regenerated artwork. -->
  <BitmapImage x:Key="ApprovedBrand" UriSource="pack://application:,,,/Assets/ArcHive-brand-approved.png" CacheOption="OnLoad"/>
  <CroppedBitmap x:Key="ArcHiveLogo" Source="{StaticResource ApprovedBrand}" SourceRect="134,150,680,710"/>
  <BitmapImage x:Key="ArcHiveIcon" UriSource="pack://application:,,,/Assets/ArcHive.ico"/>
  <SolidColorBrush x:Key="Obsidian" Color="#080D0B"/><SolidColorBrush x:Key="Surface" Color="#14231B"/><SolidColorBrush x:Key="Elevated" Color="#234532"/><SolidColorBrush x:Key="Phosphor" Color="#46E879"/><SolidColorBrush x:Key="Highlight" Color="#B3FFD0"/>
  <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Obsidian}"/><Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E1F0E6"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Elevated}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Phosphor}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Highlight}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="CaretBrush" Value="{StaticResource Phosphor}"/><Setter Property="Background" Value="{StaticResource Obsidian}"/><Setter Property="BorderBrush" Value="{StaticResource Elevated}"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#B3FFD0"/><Setter Property="Margin" Value="0,4,10,8"/><Setter Property="Padding" Value="12,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="ToggleSurface" Background="#14231B" BorderBrush="#3C6850" BorderThickness="2" CornerRadius="7" Padding="{TemplateBinding Padding}"><Grid><ContentPresenter x:Name="ToggleLabel" VerticalAlignment="Center" RecognizesAccessKey="True"/><TextBlock x:Name="BooleanLabel" Text="Off" Visibility="Collapsed" HorizontalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers>
    <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="BooleanLabel" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#234532"/><Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#46E879"/><Setter TargetName="ToggleSurface" Property="BorderThickness" Value="2"/><Setter TargetName="BooleanLabel" Property="Text" Value="On"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#B3FFD0"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#B3FFD0"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>

  <!-- Persistent selection, including when a controller moves selection without keyboard focus. -->
  <Style TargetType="ListViewItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="#14231B"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,2"/><Setter Property="ToolTip" Value="{Binding SourceSummary}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#234532"/><Setter Property="BorderBrush" Value="#46E879"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#B3FFD0"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#234532"/><Setter Property="Foreground" Value="#B3FFD0"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="BorderThickness" Value="0,1"/><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#234532"/><Setter Property="BorderBrush" Value="#46E879"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="5"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#234532"/><Setter Property="Foreground" Value="#B3FFD0"/><Setter Property="BorderBrush" Value="#46E879"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#234532"/><Setter Property="Foreground" Value="#B3FFD0"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#14231B"/><Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="Padding" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#234532"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#234532"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="Background" Value="#14231B"/><Setter Property="BorderBrush" Value="#234532"/><Setter Property="MinHeight" Value="34"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#14231B" BorderBrush="#3C6850" BorderThickness="1" CornerRadius="4"><TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Margin="9,5,28,5" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#14231B" BorderBrush="#46E879" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="350"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#46E879"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#14231B"/><Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="BorderBrush" Value="#46E879"/><Setter Property="MaxWidth" Value="700"/></Style>
  <Style TargetType="ContextMenu"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="#14231B" BorderBrush="#46E879" BorderThickness="1" Padding="3"><StackPanel IsItemsHost="True"/></Border></ControlTemplate></Setter.Value></Setter><Setter Property="Background" Value="#14231B"/><Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="BorderBrush" Value="#46E879"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="Padding" Value="14,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuBorder" Background="#14231B" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuBorder" Property="Background" Value="#234532"/><Setter TargetName="MenuBorder" Property="BorderBrush" Value="#46E879"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MenuBorder" Property="BorderBrush" Value="#46E879"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Hyperlink"><Setter Property="Foreground" Value="#B3FFD0"/></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Background" Value="#080D0B"/><Setter Property="Width" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton x:Name="ScrollBack" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#3C6850" CornerRadius="5" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="ScrollForward" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="ScrollBack" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="ScrollForward" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
  </Style>
 </Application.Resources>
</Application>
