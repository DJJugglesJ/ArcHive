<Application x:Class="ArcHive.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <!-- Exact pixels from the user-approved brand board; no regenerated artwork. -->
  <BitmapImage x:Key="ApprovedBrand" UriSource="pack://application:,,,/Assets/ArcHive-brand-approved.png" CacheOption="OnLoad"/>
  <CroppedBitmap x:Key="ArcHiveLogo" Source="{StaticResource ApprovedBrand}" SourceRect="134,150,680,710"/>
  <BitmapImage x:Key="ArcHiveIcon" UriSource="pack://application:,,,/Assets/ArcHive.ico"/>
  <SolidColorBrush x:Key="Obsidian" Color="#080D0B"/><SolidColorBrush x:Key="Surface" Color="#14231B"/><SolidColorBrush x:Key="Elevated" Color="#234532"/><SolidColorBrush x:Key="Phosphor" Color="#46E879"/><SolidColorBrush x:Key="Highlight" Color="#B3FFD0"/>
  <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Obsidian}"/><Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E1F0E6"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Elevated}"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Phosphor}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Highlight}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="CaretBrush" Value="{StaticResource Phosphor}"/><Setter Property="Background" Value="{StaticResource Obsidian}"/><Setter Property="BorderBrush" Value="{StaticResource Elevated}"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#B3FFD0"/><Setter Property="Margin" Value="0,4,12,12"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
 </Application.Resources>
</Application>
