<Window x:Class="ArcHive.App.SaveBackupsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Save backups and restore" Width="850" Height="720" MinWidth="650" MinHeight="520" WindowStartupLocation="CenterOwner" Background="#080D0B" Foreground="#E1F0E6" FontFamily="Segoe UI">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="Heading" FontSize="24"/><TextBlock Text="Close the game and pause cloud-save syncing before backup or restore. Choose only the game's save subfolder. Snapshots are local and unencrypted." TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,12"/></StackPanel>
  <StackPanel Grid.Row="1" x:Name="Actions"><TextBlock Text="Save location"/><ComboBox x:Name="Locations" SelectionChanged="SaveLocationChanged" Margin="0,6,0,10"/><TextBlock x:Name="FullPath" TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,0,0,10"/>
   <WrapPanel><Button Content="Add save folder" Click="AddFolder"/><TextBlock Text="Keep regular snapshots:" VerticalAlignment="Center" Margin="0,0,8,8"/><ComboBox x:Name="Retention" Width="70" Margin="0,0,8,8"/><Button Content="Save retention" Click="SaveRetention"/></WrapPanel>
   <WrapPanel><Button Content="Back up now" Click="Backup"/><Button Content="Preview restore" Click="Preview"/><Button x:Name="RestoreButton" Content="Restore snapshot" Click="Restore" IsEnabled="False"/><Button Content="Recover interrupted restore" Click="Recover"/></WrapPanel>
  </StackPanel>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><ListBox x:Name="Snapshots" SelectionChanged="SnapshotChanged" AutomationProperties.Name="Save snapshots"/><TextBox Grid.Row="1" x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Restore preview"/></Grid>
  <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Cancel operation" Click="Cancel"/><TextBlock x:Name="Status" Text="Select a save folder. Protected pre-restore snapshots are never automatically removed." TextWrapping="Wrap" Foreground="#B3FFD0"/></DockPanel>
 </Grid>
</Window>
