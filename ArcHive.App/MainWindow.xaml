<Window x:Class="ArcHive.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcHive.App" Background="#080D0B" Foreground="#E1F0E6" FontFamily="Segoe UI" Title="ArcHive" Icon="{StaticResource ArcHiveIcon}" Width="1440" Height="900" MinWidth="1000" MinHeight="650">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#101B15" BorderBrush="#234532" BorderThickness="0,0,1,0" Padding="20,30"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><Image Source="{x:Static local:BrandArtwork.Logo}" Width="150" Height="157" Stretch="Uniform" AutomationProperties.Name="ArcHive approved arcade and honeycomb logo"/><TextBlock Text="YOUR GAMES. PRESERVED." FontSize="9" Foreground="#8FAA99" Margin="0,8,0,28"/>
    <TextBlock Text="COLLECTION" FontFamily="Consolas" FontSize="10" Foreground="#8FAA99" Margin="0,0,0,16"/>
    <Button x:Name="LibraryNav" Content="All games" Click="NavigateLibrary" HorizontalContentAlignment="Left"/><Button x:Name="FavoritesNav" Content="Favorites" Click="NavigateFavorites" HorizontalContentAlignment="Left"/><Button x:Name="ArchivesNav" Content="Archive manager" Click="NavigateArchives" HorizontalContentAlignment="Left"/>
   </StackPanel>
   <StackPanel VerticalAlignment="Bottom"><TextBlock Text="LOCAL FIRST" FontFamily="Consolas" Foreground="#46E879" FontSize="11"/><TextBlock Text="From archive to adventure." FontSize="10" Foreground="#8FAA99" Margin="0,8,0,0"/></StackPanel>
  </DockPanel></Border>
  <DockPanel Grid.Column="1" Margin="28,26,24,16">
   <StackPanel DockPanel.Dock="Top"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Your library" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="A home for every game you discover." Foreground="#8FAA99" Margin="0,6,0,20"/></StackPanel><WrapPanel Grid.Column="1" x:Name="Toolbar"><Button Content="Add library folder" Click="AddRoot"/><Button Content="Rescan" Click="Rescan"/><Button x:Name="InspectorToggle" Content="Hide details" Click="ToggleInspector"/></WrapPanel></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" TextChanged="FilterChanged" ToolTip="Search titles and tags" AutomationProperties.Name="Search titles and tags"/><CheckBox Grid.Column="1" x:Name="FavoritesOnly" Content="Favorites only" VerticalAlignment="Center" Margin="16,0,0,0" Checked="FilterChanged" Unchecked="FilterChanged"/></Grid>
   </StackPanel>
   <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel operation" Click="Cancel" IsEnabled="False"/><TextBlock x:Name="Status" Text="Add a folder to start your library." FontFamily="Consolas" FontSize="11" Foreground="#8FAA99" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
   <Grid x:Name="Workspace"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="InspectorColumn" Width="360"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,18,0">
     <ListBox x:Name="Games" Visibility="Collapsed" SelectionChanged="SelectGame"/>
     <ListBox x:Name="Gallery" SizeChanged="GalleryResized" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding Games}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
       <Button Click="SelectCard" Tag="{Binding}" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}"><Grid Height="260"><Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition/></Grid.RowDefinitions>
        <Border Background="#14231B" CornerRadius="7,7,0,0" ClipToBounds="True"><Grid><TextBlock Text="AR / HIVE" FontFamily="Consolas" Foreground="#3C6850" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/><local:Artwork ImagePath="{Binding ScreenshotPath}" Stretch="UniformToFill"/></Grid></Border>
        <StackPanel Grid.Row="1" Margin="12,10"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding State}" Foreground="#8FAA99" FontSize="11" Margin="0,7,0,0"/></StackPanel>
       </Grid></Button>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <ListView x:Name="ArchiveList" Visibility="Collapsed" SelectionChanged="SelectArchiveRow" Background="#080D0B" Foreground="#E1F0E6" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListView.View><GridView><GridViewColumn Header="Game" Width="230" DisplayMemberBinding="{Binding Title}"/><GridViewColumn Header="Archives" Width="70" DisplayMemberBinding="{Binding Archives.Count}"/><GridViewColumn Header="State" Width="150" DisplayMemberBinding="{Binding State}"/></GridView></ListView.View></ListView>
     <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="330"><TextBlock Text="Your next adventure starts here." FontSize="22" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock Text="Add a folder containing games or ZIP, RAR and 7z archives. Your original files stay in place." Foreground="#8FAA99" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,20"/><Button Content="Add library folder" Click="AddRoot" HorizontalAlignment="Center"/></StackPanel>
    </Grid>
    <Border x:Name="InspectorBorder" Grid.Column="1" Background="#14231B" CornerRadius="12" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details" IsEnabled="False">
     <Border Height="180" Background="#080D0B" CornerRadius="8" ClipToBounds="True"><Grid><TextBlock Text="GAME DETAILS" FontFamily="Consolas" Foreground="#3C6850" HorizontalAlignment="Center" VerticalAlignment="Center"/><local:Artwork x:Name="Screenshot" Stretch="UniformToFill"/></Grid></Border>
     <TextBlock x:Name="DetailTitle" Text="Select a game" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,6"/><TextBlock x:Name="DetailState" Foreground="#B3FFD0" FontSize="11" Margin="0,0,0,18"/>
     <WrapPanel><Button Content="Launch game" Click="Launch" Background="#46E879" Foreground="#080D0B"/><Button x:Name="ExtractButton" Content="Extract archive" Click="Extract"/></WrapPanel>
     <TextBlock Text="Title"/><TextBox x:Name="TitleBox"/><WrapPanel><CheckBox x:Name="FavoriteBox" Content="Favorite"/><CheckBox x:Name="PlayedBox" Content="Played"/></WrapPanel>
     <TextBlock Text="Tags (comma separated)"/><TextBox x:Name="TagsBox"/><TextBlock Text="Description / notes"/><TextBox x:Name="DescriptionBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button Content="Save details" Click="SaveDetails"/>
     <Expander Header="Files and launch setup" Foreground="#B3FFD0" Margin="0,12,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="Archive to extract"/><ComboBox x:Name="ArchiveChoices" SelectionChanged="SelectedLocationChanged" Margin="0,4,0,12" AutomationProperties.Name="Archive to extract"/><TextBlock Text="Folder to launch from"/><ComboBox x:Name="FolderChoices" SelectionChanged="SelectedLocationChanged" Margin="0,4,0,12" AutomationProperties.Name="Folder to launch from"/><TextBlock x:Name="Paths" TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,0,0,12"/><WrapPanel><Button Content="Add archive" Click="AddArchive"/><Button Content="Add folder" Click="LinkFolder"/><Button Content="Add artwork" Click="AddScreenshot"/><Button Content="Choose executable" Click="ChooseExecutable"/></WrapPanel></StackPanel></Expander>
    </StackPanel></ScrollViewer></Border>
   </Grid>
  </DockPanel>
 </Grid>
</Window>
