<Window PreviewKeyDown="WindowOptionsKey" x:Class="ArcHive.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:ArcHive.Core;assembly=ArcHive.Core" xmlns:local="clr-namespace:ArcHive.App" Background="#080D0B" Foreground="#E1F0E6" FontFamily="Segoe UI" Title="ArcHive" Icon="{StaticResource ArcHiveIcon}" Width="1440" Height="900" MinWidth="1000" MinHeight="650">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#101B15" BorderBrush="#234532" BorderThickness="0,0,1,0" Padding="20,30"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><Image Source="{x:Static local:BrandArtwork.Logo}" Width="150" Height="157" Stretch="Uniform" AutomationProperties.Name="ArcHive approved arcade and honeycomb logo"/><TextBlock Text="FROM ARCHIVE TO ADVENTURE." FontSize="9" Foreground="#8FAA99" Margin="0,8,0,28"/>
    <TextBlock Text="LIBRARY" FontFamily="Consolas" FontSize="10" Foreground="#8FAA99" Margin="0,0,0,16"/>
    <Button x:Name="LibraryNav" Content="{x:Static core:UiText.Library}" Click="NavigateLibrary" HorizontalContentAlignment="Left"/><Button x:Name="FavoritesNav" Content="Favorites" Click="NavigateFavorites" HorizontalContentAlignment="Left"/><Button x:Name="ArchivesNav" Content="{x:Static core:UiText.Archives}" Click="NavigateArchives" HorizontalContentAlignment="Left"/>
   <TextBlock Text="TOOLS" Foreground="#8FAA99" FontSize="10" Margin="0,22,0,12"/><Button Content="Activity" Click="OpenExtractionQueue" HorizontalContentAlignment="Left"/><Button Content="{x:Static core:UiText.OrganizeLibrary}" Click="OrganizeLibrary" HorizontalContentAlignment="Left"/></StackPanel>
   <StackPanel VerticalAlignment="Bottom"><TextBlock Margin="0,0,0,12" FontSize="11">Metadata: <Hyperlink NavigateUri="https://rawg.io/" RequestNavigate="OpenMetadataSource">RAWG</Hyperlink> + sources</TextBlock><Button Content="Settings" Click="OpenSettings" HorizontalContentAlignment="Left"/><TextBlock x:Name="ControllerNavigationHint" FontSize="10" Foreground="#8FAA99" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="LOCAL FIRST" FontFamily="Consolas" Foreground="#46E879" FontSize="11"/><TextBlock Text="From archive to adventure." FontSize="10" Foreground="#8FAA99" Margin="0,8,0,0"/></StackPanel>
  </DockPanel></Border>
  <DockPanel Grid.Column="1" Margin="28,26,24,16">
   <StackPanel DockPanel.Dock="Top"><StackPanel><TextBlock x:Name="PageTitle" Text="{x:Static core:UiText.Library}" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Your games, all in one place." Foreground="#8FAA99" Margin="0,6,0,20"/></StackPanel><WrapPanel x:Name="Toolbar"><Button x:Name="BackToLibrary" Content="← Back to Library" Click="BackToCollection" Visibility="Collapsed"/><WrapPanel x:Name="CollectionActions"><Button Content="Add Games" Click="OpenAddGames" Background="#234532"/><Button Content="Rescan Folders" Click="Rescan"/></WrapPanel><Button x:Name="InspectorToggle" Visibility="Collapsed" Content="Open details" Click="ToggleInspector"/></WrapPanel>
    <Grid x:Name="SearchFilters"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" TextChanged="FilterChanged" ToolTip="Search games and tags" AutomationProperties.Name="Search games and tags"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Browse…" Click="OpenLibraryFilters"/><Button x:Name="NsfwToggle" Click="ToggleNsfw" Background="Transparent" BorderBrush="Transparent" Padding="4" Margin="10,4,0,12" VerticalAlignment="Center" Width="34" Height="30"><Grid Width="24" Height="24"><Ellipse x:Name="NsfwCircle" Stroke="#718378" StrokeThickness="1" Margin="1"/><TextBlock x:Name="NsfwLabel" Text="18" FontSize="9" Foreground="#8FAA99" HorizontalAlignment="Center" VerticalAlignment="Center"/><Line x:Name="NsfwSlash" X1="4" Y1="20" X2="20" Y2="4" Stroke="#718378" StrokeThickness="1"/></Grid></Button><ComboBox x:Name="StatusFilter" Width="130" Margin="12,4,0,12" SelectionChanged="FilterChanged" AutomationProperties.Name="Filter by Play Status"/><CheckBox x:Name="FavoritesOnly" Content="Favorites Only" VerticalAlignment="Center" Margin="16,0,0,0" Checked="FilterChanged" Unchecked="FilterChanged"/></StackPanel></Grid>
   <Expander x:Name="TagBrowser" Header="Browse by tag" Foreground="#B3FFD0" Margin="0,4,0,8"><StackPanel><WrapPanel><Button x:Name="ActiveTagButton" Content="All tags" Click="ClearTagFilter"/><TextBlock Text="Choose a tag to filter your library" VerticalAlignment="Center" Foreground="#8FAA99"/></WrapPanel><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="LibraryTagButtons"/></ScrollViewer></StackPanel></Expander>
   </StackPanel>
   <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="{x:Static core:UiText.Cancel}" Click="Cancel" IsEnabled="False"/><TextBlock x:Name="Status" Text="Add a folder to start your library." FontFamily="Consolas" FontSize="11" Foreground="#8FAA99" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
   <Grid x:Name="Workspace"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="InspectorColumn" Width="0"/></Grid.ColumnDefinitions>
    <Grid x:Name="BrowsePane">
     <ListBox x:Name="Games" Visibility="Collapsed" SelectionChanged="SelectGame"/>
     <ListBox PreviewKeyDown="LibraryKey" x:Name="Gallery" SizeChanged="GalleryResized" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding Games}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
       <Button GotKeyboardFocus="FocusCard" PreviewMouseRightButtonDown="CardRightClick" ToolTip="{Binding SourceSummary}" Click="SelectCard" Tag="{Binding}" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#46E879"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid Height="285"><Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition/></Grid.RowDefinitions>
        <Border Background="#14231B" CornerRadius="7,7,0,0" ClipToBounds="True"><Grid><TextBlock Text="AR / HIVE" FontFamily="Consolas" Foreground="#3C6850" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/><local:Artwork Reference="{Binding Artwork.Cover}" ImagePath="{Binding ScreenshotPath}" Stretch="UniformToFill"/></Grid></Border>
        <StackPanel Grid.Row="1" Margin="12,10"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal"><local:ControllerJewel Profile="{Binding ActiveControllerProfile, RelativeSource={RelativeSource AncestorType=Window}}" Width="18" Height="18" Margin="0,4,6,0" ToolTip="{Binding ControllerSupport}"><local:ControllerJewel.Style><Style TargetType="local:ControllerJewel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasControllerSupport}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:ControllerJewel.Style></local:ControllerJewel><TextBlock Text="{Binding CardStatus}" Foreground="#8FAA99" FontSize="11" Margin="0,7,0,0"/></StackPanel><TextBlock Text="{Binding CompactSource}" Foreground="#8FAA99" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel>
       </Grid></Button>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <ListView PreviewKeyDown="LibraryKey" PreviewMouseRightButtonDown="ArchiveRightClick" PreviewMouseLeftButtonUp="OpenArchiveDetails" x:Name="ArchiveList" Visibility="Collapsed" SelectionChanged="SelectArchiveRow" Background="#080D0B" Foreground="#E1F0E6" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListView.View><GridView><GridViewColumn Header="Game" Width="230" DisplayMemberBinding="{Binding Title}"/><GridViewColumn Header="{x:Static core:UiText.Archives}" Width="70" DisplayMemberBinding="{Binding Archives.Count}"/><GridViewColumn Header="{x:Static core:UiText.InstallationStatus}" Width="100" DisplayMemberBinding="{Binding InstallationStatus}"/><GridViewColumn Header="Source Path" Width="420" DisplayMemberBinding="{Binding CompactSource}"/></GridView></ListView.View></ListView>
     <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="330"><TextBlock x:Name="EmptyTitle" Text="Your library is empty." FontSize="22" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="Add a library folder to discover your games and archives." Foreground="#8FAA99" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,20"/><Button Content="Add Library Folder…" Click="AddRoot" HorizontalAlignment="Center"/></StackPanel>
    </Grid>
    <Border x:Name="InspectorBorder" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" MaxWidth="1100" Background="#14231B" CornerRadius="12" Padding="24"><ScrollViewer x:Name="DetailsScroller" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details" IsEnabled="False">
     <Border Height="260" Background="#080D0B" CornerRadius="8" ClipToBounds="True"><Grid><TextBlock Text="GAME DETAILS" FontFamily="Consolas" Foreground="#3C6850" HorizontalAlignment="Center" VerticalAlignment="Center"/><local:Artwork x:Name="Screenshot" Stretch="UniformToFill"/></Grid></Border>
     <TextBlock x:Name="DetailTitle" Text="Select a game" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,6"/><TextBlock x:Name="DetailState" Foreground="#B3FFD0" FontSize="11" Margin="0,0,0,18"/>
<WrapPanel><Button x:Name="PlayButton" Click="PrimaryGameAction" Background="#46E879" Foreground="#080D0B" AutomationProperties.Name="Play Game"><StackPanel Orientation="Horizontal"><local:ControllerJewel Profile="{Binding ActiveControllerProfile, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,0"/><TextBlock x:Name="PrimaryActionLabel" Text="Play Game" Foreground="#080D0B" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="ExtractButton" Content="{x:Static core:UiText.ManageArchive}" Click="Extract"/><Button x:Name="DetailsOptionsButton" Content="Options · △ / Y" Click="OpenOptions"/></WrapPanel>
<TextBlock Text="Tags" FontSize="18"/><TextBlock x:Name="NoTagsHint" Text="No tags yet. Add your own or review tags from a source." Foreground="#8FAA99" Margin="0,8"/><WrapPanel x:Name="DetailTagButtons" Margin="0,8"/><WrapPanel><Button Content="Edit Tags…" Click="EditTags"/><Button Content="Import from F95Zone Link…" Click="OpenF95Thread"/></WrapPanel><TextBlock Text="Select a tag to find matching games." Foreground="#8FAA99" Margin="0,4,0,16"/>
     <TabControl x:Name="GameSections" Margin="0,20,0,0"><TabItem Header="Overview"><StackPanel Margin="0,14,0,0"><WrapPanel><Button Content="Playtime &amp; Naming…" Click="OpenGameHistory"/></WrapPanel><TextBlock Text="Description" FontSize="18"/><TextBlock x:Name="OverviewDescription" TextWrapping="Wrap" Foreground="#B3FFD0" Margin="0,12,0,18"/><Expander Header="Edit Details" Foreground="#B3FFD0"><StackPanel Margin="0,12,0,0"><TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">Metadata sources: <Hyperlink NavigateUri="https://store.steampowered.com/" RequestNavigate="OpenMetadataSource">Steam</Hyperlink> · <Hyperlink NavigateUri="https://www.igdb.com/" RequestNavigate="OpenMetadataSource">IGDB</Hyperlink> · <Hyperlink NavigateUri="https://itch.io/" RequestNavigate="OpenMetadataSource">itch.io</Hyperlink> · <Hyperlink NavigateUri="https://rawg.io/" RequestNavigate="OpenMetadataSource">RAWG</Hyperlink> · <Hyperlink NavigateUri="https://vndb.org/" RequestNavigate="OpenMetadataSource">VNDB</Hyperlink></TextBlock>
     <TextBlock Text="Title"/><TextBox x:Name="TitleBox"/><WrapPanel><CheckBox x:Name="FavoriteBox" Content="Favorite"/><CheckBox x:Name="PlayedBox" Content="Played"/><CheckBox x:Name="NsfwBox" Content="NSFW" ToolTip="Hide this game when the 18+ visibility control is off. Save details to apply."/></WrapPanel>
     <TextBlock Text="Controller Support"/><ComboBox x:Name="ControllerSupportBox" Margin="0,4,0,12" AutomationProperties.Name="Controller Support"/><TextBlock Text="{x:Static core:UiText.PlayStatus}"/><ComboBox x:Name="ProgressBox" Margin="0,4,0,12" AutomationProperties.Name="Play Status"/>
     <TextBlock Text="Tags"/><TextBox x:Name="TagsBox"/><TextBlock Text="Description &amp; Notes"/><TextBox x:Name="DescriptionBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button Content="{x:Static core:UiText.SaveChanges}" Click="SaveDetails"/>
     <WrapPanel><Button Content="{x:Static core:UiText.FindInformation}" Click="FindMetadata"/><Button Content="Undo Information Changes" Click="UndoMetadata"/></WrapPanel>
     <TextBlock Text="Release Year"/><TextBox x:Name="ReleaseYearBox"/><TextBlock Text="Game Engine" VerticalAlignment="Center" Margin="12,0,8,0"/><TextBox x:Name="EngineBox"/></StackPanel></Expander></StackPanel></TabItem>
     <TabItem Header="Media"><StackPanel><TextBlock x:Name="ArtworkSources" TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="Manage covers, backdrops, and screenshots. Use Find Game Information to discover additional artwork." TextWrapping="Wrap"/><WrapPanel><Button Content="Clear Cover" Click="ClearCover"/><Button Content="Clear Backdrop" Click="ClearBackdrop"/></WrapPanel><ItemsControl x:Name="ScreenshotStrip"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><local:Artwork Reference="{Binding}" Height="140" Stretch="Uniform"/><TextBlock Text="{Binding Provider}"/><Button Content="Remove Screenshot" Click="RemoveScreenshot" Tag="{Binding}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></TabItem>
     <TabItem Header="Versions"><StackPanel Margin="0,12,0,0">
      <TextBlock x:Name="UpdateHint" TextWrapping="Wrap"/>
      <TextBlock Text="Latest Known Version" Margin="0,12,0,0"/><TextBox x:Name="LatestVersionBox"/>
      <TextBlock Text="Latest Release Details"/><TextBox x:Name="LatestPlatformBox" ToolTip="Platform, e.g. Windows x64"/><TextBox x:Name="LatestChannelBox" ToolTip="Release channel, e.g. stable"/>
      <TextBlock Text="Version Source / Notes"/><TextBox x:Name="LatestSourceBox"/>
      <TextBlock Text="Release History"/><ItemsControl x:Name="VersionHistory" Margin="0,8,0,12"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></TabItem>
     <TabItem Header="Launch"><StackPanel Margin="0,12,0,0">     <TextBox x:Name="SelectedSource" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected game source locations"/><WrapPanel><Button Content="{x:Static core:UiText.ScanGameFiles}" Click="DetectLaunch"/><Button x:Name="OpenGameFolderButton" Content="{x:Static core:UiText.OpenGameFolder}" ToolTip="Open the selected game installation. Unavailable for archive-only games." Click="OpenSource"/><Button Content="Copy Full Paths" Click="CopySourcePaths"/></WrapPanel><TextBlock Text="Archive to extract"/><ComboBox x:Name="ArchiveChoices" SelectionChanged="SelectedLocationChanged" Margin="0,4,0,12" AutomationProperties.Name="Archive to extract"/><TextBlock Text="Archive version / platform / channel"/><TextBox x:Name="ArchiveVersionBox"/><TextBox x:Name="ArchivePlatformBox"/><TextBox x:Name="ArchiveChannelBox"/>
      <TextBlock Text="Installation"/><ComboBox x:Name="FolderChoices" SelectionChanged="SelectedLocationChanged" Margin="0,4,0,12" AutomationProperties.Name="Installation"/><TextBlock Text="Installed version / platform / channel"/><TextBox x:Name="InstalledVersionBox"/><TextBox x:Name="InstalledPlatformBox"/><TextBox x:Name="InstalledChannelBox"/>
      <TextBlock Text="Launch Profile"/><ComboBox x:Name="ProfileChoices" SelectionChanged="ProfileChanged" Margin="0,4,0,12" AutomationProperties.Name="Launch Profile"/>
      <TextBlock x:Name="DefaultProfileHint" Foreground="#8FAA99" TextWrapping="Wrap"/>
      <WrapPanel><Button Content="Add Profile" Click="NewProfile"/><Button Content="Remove Profile" Click="RemoveProfile"/><Button Content="Set as Default" Click="DefaultProfile"/></WrapPanel>
      <StackPanel x:Name="ProfileEditor"><TextBlock Text="Launch Adapter"/><ComboBox x:Name="AdapterChoices"/><TextBlock x:Name="AdapterHint" TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,6,0,12"/><TextBlock Text="Profile Name"/><TextBox x:Name="ProfileNameBox"/><TextBlock Text="Executable"/><TextBox x:Name="ProfileExecutableBox"/><TextBlock Text="Launch Arguments"/><ItemsControl x:Name="ProfileArgumentRows"><ItemsControl.ItemTemplate><DataTemplate><DockPanel><Button DockPanel.Dock="Right" Content="Remove" Click="RemoveArgument" Tag="{Binding}" Padding="8,5"/><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="35" MaxHeight="90" VerticalScrollBarVisibility="Auto" ToolTip="Literal argument; an empty row passes an empty argument."/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Add Argument" Click="AddArgument"/><TextBlock Text="Working Directory"/><TextBox x:Name="ProfileWorkingBox"/></StackPanel>
      <Button Content="{x:Static core:UiText.SaveChanges}" Click="SaveDetails"/>
      <TextBlock x:Name="Paths" TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,0,0,12"/><WrapPanel><Button Content="Add Archive…" Click="AddArchive"/><Button Content="Add Game Folder…" Click="LinkFolder"/><Button Content="Add Artwork…" Click="AddScreenshot"/><Button Content="Choose Executable…" Click="ChooseExecutable"/></WrapPanel></StackPanel></TabItem><TabItem Header="Sources"><StackPanel Margin="0,18"><TextBlock Text="Keep every match traceable" FontSize="18"/><TextBlock Text="Review candidates and choose exactly which metadata fields or artwork to change." TextWrapping="Wrap" Margin="0,10"/><WrapPanel><Button Content="{x:Static core:UiText.FindInformation}" Click="FindMetadata"/><Button Content="Undo Information Changes" Click="UndoMetadata"/><Button x:Name="F95ThreadButton" Content="F95Zone Thread &amp; Updates…" Click="OpenF95Thread"/></WrapPanel></StackPanel></TabItem><TabItem Header="Backups"><StackPanel Margin="0,18"><TextBlock Text="Protect your progress" FontSize="18"/><TextBlock Text="Choose a game's save folder, create snapshots, or preview a restore. Close the game before changing its saves." TextWrapping="Wrap" Margin="0,10"/><Button Content="Save Backups…" Click="OpenSaveBackups" HorizontalAlignment="Left"/></StackPanel></TabItem></TabControl>
    </StackPanel></ScrollViewer></Border>
   </Grid>
  </DockPanel>
 </Grid>
</Window>
