<Window x:Class="ArcHive.App.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ArcHive Updates" Width="720" Height="660" MinWidth="560" MinHeight="450" WindowStartupLocation="CenterOwner" Background="#080D0B" Foreground="#E1F0E6" FontFamily="Segoe UI">
 <DockPanel Margin="26"><StackPanel DockPanel.Dock="Top"><TextBlock Text="ArcHive Updates" FontSize="26"/><TextBlock x:Name="CurrentVersion" Margin="0,8,0,14"/><TextBlock Text="Updates come from published ArcHive GitHub releases. Your library, game files and settings stay in place. Portable copies install the managed edition alongside the portable folder." TextWrapping="Wrap" Foreground="#8FAA99"/><TextBlock Text="Download location" Foreground="#8FAA99" Margin="0,14,0,4"/><DockPanel><Button x:Name="LocationButton" DockPanel.Dock="Right" Content="Change…" Click="ChooseDownloadFolder" AutomationProperties.Name="Change update download location"/><TextBlock x:Name="DownloadLocation" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="Downloads use Windows temporary storage, separate from your library. If Windows Installer cannot open a package, choose another local folder and download again." TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,8,0,0"/><TextBlock x:Name="Status" Text="Check for a newer Windows release." TextWrapping="Wrap" Margin="0,16"/><ProgressBar x:Name="Progress" Height="7" Minimum="0" Maximum="100" Visibility="Collapsed"/></StackPanel>
 <WrapPanel DockPanel.Dock="Bottom" Margin="0,18,0,0"><Button x:Name="CheckButton" Content="Check for Updates" Click="Check"/><Button x:Name="DownloadButton" Content="Download Update" Click="Download" IsEnabled="False"/><Button x:Name="InstallButton" Content="Close ArcHive and Install" Click="Install" IsEnabled="False"/><Button x:Name="StopButton" Content="Stop" Click="Stop" Visibility="Collapsed"/><Button Content="Back" IsCancel="True"/></WrapPanel>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Notes" TextWrapping="Wrap" Margin="0,16"/></ScrollViewer></DockPanel>
</Window>
