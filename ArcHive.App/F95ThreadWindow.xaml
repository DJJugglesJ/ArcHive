<Window x:Class="ArcHive.App.F95ThreadWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="F95Zone thread" Width="760" Height="660" MinWidth="600" MinHeight="480" WindowStartupLocation="CenterOwner" Background="#080D0B" Foreground="#E1F0E6" FontFamily="Segoe UI"><DockPanel Margin="26">
 <StackPanel DockPanel.Dock="Top"><TextBlock Text="A source you can trace" FontSize="26"/><TextBlock Text="Link one thread to this game. Public lookup reads page metadata only; it never downloads game files or uses browser cookies." TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,12"/><TextBlock Text="F95Zone thread URL"/><TextBox x:Name="ThreadUrl" TextChanged="UrlChanged"/><WrapPanel x:Name="Actions"><Button Content="Check public thread" Click="CheckThread"/><Button Content="Open in browser" Click="OpenThread"/><Button x:Name="Review" Content="Review metadata" Click="ReviewMetadata" IsEnabled="False"/></WrapPanel></StackPanel>
 <StackPanel DockPanel.Dock="Bottom"><CheckBox x:Name="UseVersion" Content="Use observed version as latest known version" IsEnabled="False"/><TextBlock Text="Your title, engine and installed versions stay unchanged unless you explicitly apply a change. Save link commits the reviewed changes; Cancel discards them." TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,8"/><WrapPanel><Button Content="Save link and reviewed changes" Click="Save"/><Button Content="Cancel" IsCancel="True"/></WrapPanel><TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#B3FFD0"/></StackPanel>
 <TextBox x:Name="Evidence" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
</DockPanel></Window>
