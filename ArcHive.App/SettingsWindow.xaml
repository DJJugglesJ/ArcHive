<Window x:Class="ArcHive.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcHive.App" Title="ArcHive settings" Width="980" Height="780" MinWidth="780" MinHeight="580" WindowStartupLocation="CenterOwner" Background="#080D0B" Foreground="#E1F0E6" FontFamily="Segoe UI">
 <DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Make ArcHive yours" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Your library, your sources, your controls." Foreground="#8FAA99" Margin="0,6,0,22"/></StackPanel>
  <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Save preferences" Click="Save"/><Button Content="Close" IsCancel="True"/></WrapPanel>
  <TabControl TabStripPlacement="Left">
   <TabItem Header="Library"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="A library that feels like yours" FontSize="22"/><TextBlock Text="Default ordering" Margin="0,22,0,6"/><ComboBox x:Name="Order"/><TextBlock Text="Artwork grid" Margin="0,18,0,6"/><ComboBox x:Name="Density"/><TextBlock Text="Library folders" FontSize="18" Margin="0,24,0,10"/><ListBox x:Name="Roots" MaxHeight="180"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource CompactPath}}" ToolTip="{Binding}" Margin="4,6"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Adding folders scans in place. Your original files stay where they are." TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,12"/><WrapPanel><Button Content="Add a library folder" Tag="add" Click="Route"/><Button Content="Rescan folders" Tag="scan" Click="Route"/><Button Content="Organize library" Tag="organize" Click="Route"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Sources"><DockPanel><Button DockPanel.Dock="Bottom" Content="Import owned Steam / GOG library" Tag="import" Click="Route" HorizontalAlignment="Left" Margin="24,12"/><local:SourceConnections/></DockPanel></TabItem>
   <TabItem Header="Controls"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Play your way" FontSize="22"/><TextBlock Text="Controller button symbols" Margin="0,22,0,8"/><ComboBox x:Name="Profiles" SelectionChanged="ProfileChanged"/><StackPanel Orientation="Horizontal" Margin="0,16"><local:ControllerJewel x:Name="Accept"/><local:ControllerJewel x:Name="CancelJewel" Position="1" Margin="8,0"/><local:ControllerJewel x:Name="Alternate" Position="2"/><local:ControllerJewel x:Name="Menu" Position="3" Margin="8,0"/></StackPanel><CheckBox x:Name="Gamepad" Content="Gamepad navigation"/><TextBlock Text="Cross / A opens details. Choose Play to launch. Triangle / Y opens game options. Circle / B returns to the collection. DualSense and DS4 use native USB or Bluetooth input; Xbox uses XInput." TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,12"/><TextBlock Text="Keyboard &amp; mouse" FontSize="18" Margin="0,24,0,8"/><TextBlock Text="Click a game to open it. Right-click or Shift+F10 for options. Arrow keys browse the collection; Enter opens details. Escape returns to browsing." TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Storage"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Local and under your control" FontSize="22"/><TextBlock Text="Library data" Margin="0,22,0,6"/><TextBlock x:Name="DataLocation" TextWrapping="Wrap"/><Button Content="Open data folder" Click="OpenData" HorizontalAlignment="Left" Margin="0,12"/><TextBlock Text="Save backups" FontSize="18" Margin="0,18,0,8"/><TextBlock Text="Open a game → Options → Save backups and restore. Choose its save folder, make a snapshot, or preview a restore. Protected pre-restore snapshots stay until you remove them yourself." TextWrapping="Wrap"/><TextBlock Text="Archive extraction" FontSize="18" Margin="0,24,0,8"/><TextBlock Text="Inspect contents before extracting. Queue jobs, cancel safely, and retry interrupted work from Activity." TextWrapping="Wrap"/><Button Content="Open extraction activity" Tag="queue" Click="Route" HorizontalAlignment="Left" Margin="0,12"/><TextBlock Text="Saved credentials live in Windows Credential Manager. ArcHive keeps no passwords or API keys in its library, settings files or logs. Browser sign-ins stay in your browser." TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,16"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Optional sources"><StackPanel Margin="24"><TextBlock Text="Choose what you connect" FontSize="22"/><CheckBox x:Name="F95Enabled" Content="Enable F95Zone thread tools" Margin="0,20,0,12"/><TextBlock Text="Adds explicit thread linking and public-page metadata checks to game options. No background browsing, browser-cookie access, or automatic downloads. A linked source never changes your metadata or latest version without review." TextWrapping="Wrap" Foreground="#8FAA99"/><TextBlock Text="F95Zone may require a browser login. Opening its website does not connect that browser session to ArcHive." TextWrapping="Wrap" Margin="0,14"/></StackPanel></TabItem>
   <TabItem Header="About"><StackPanel Margin="24"><TextBlock Text="ArcHive" FontSize="28"/><TextBlock Text="Your games. Preserved." Margin="0,8,0,22" Foreground="#8FAA99"/><Button Content="About ArcHive" Click="ShowAbout" HorizontalAlignment="Left"/></StackPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
