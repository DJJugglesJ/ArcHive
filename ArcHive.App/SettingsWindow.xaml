<Window x:Class="ArcHive.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:ArcHive.Core;assembly=ArcHive.Core" xmlns:local="clr-namespace:ArcHive.App" Title="ArcHive Settings" Width="980" Height="780" MinWidth="780" MinHeight="580" WindowStartupLocation="CenterOwner" Background="#080D0B" Foreground="#E1F0E6" FontFamily="Segoe UI">
 <DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Your library, your sources, your controls." Foreground="#8FAA99" Margin="0,6,0,22"/></StackPanel>
  <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Save Preferences" Click="Save"/><Button Content="Close" IsCancel="True"/></WrapPanel>
  <TabControl x:Name="SettingsTabs" TabStripPlacement="Left">
   <TabItem Header="Library Preferences"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Library Preferences" FontSize="22"/><TextBlock Text="Default Ordering" Margin="0,22,0,6"/><ComboBox x:Name="Order"/><TextBlock Text="Artwork Grid" Margin="0,18,0,6"/><ComboBox x:Name="Density"/><TextBlock Text="Library Folders" FontSize="18" Margin="0,24,0,10"/><ListBox x:Name="Roots" MaxHeight="180"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource CompactPath}}" ToolTip="{Binding}" Margin="4,6"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Adding folders scans in place. Your original files stay where they are." TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,12"/><WrapPanel><Button Content="Add Library Folder…" Tag="add" Click="Route"/><Button Content="Rescan Folders" Tag="scan" Click="Route"/><Button Content="{x:Static core:UiText.OrganizeLibrary}" Tag="organize" Click="Route"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Manage Your Sources"><DockPanel><Button DockPanel.Dock="Bottom" Content="Import Owned Games…" Tag="import" Click="Route" HorizontalAlignment="Left" Margin="24,12"/><local:SourceConnections/></DockPanel></TabItem>
   <TabItem Header="Input &amp; Navigation"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Input &amp; Navigation" FontSize="22"/><TextBlock Text="Controller Button Symbols" Margin="0,22,0,8"/><ComboBox x:Name="Profiles" SelectionChanged="ProfileChanged"/><StackPanel Orientation="Horizontal" Margin="0,16"><local:ControllerJewel x:Name="Accept"/><local:ControllerJewel x:Name="CancelJewel" Position="1" Margin="8,0"/><local:ControllerJewel x:Name="Alternate" Position="2"/><local:ControllerJewel x:Name="Menu" Position="3" Margin="8,0"/></StackPanel><CheckBox x:Name="Gamepad" Content="Gamepad Navigation"/><TextBlock Text="{x:Static core:UiText.ControllerHelp}" TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,12"/><TextBlock Text="Keyboard &amp; Mouse" FontSize="18" Margin="0,24,0,8"/><TextBlock Text="Click a game to open it. Right-click or Shift+F10 for options. Arrow keys browse the collection; Enter opens details. Escape returns to browsing." TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Storage &amp; Backups"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock Text="Storage &amp; Backups" FontSize="22"/><TextBlock Text="Library Data" Margin="0,22,0,6"/><TextBlock x:Name="DataLocation" TextWrapping="Wrap"/><Button Content="Open Data Folder" Click="OpenData" HorizontalAlignment="Left" Margin="0,12"/><TextBlock Text="Save Backups" FontSize="18" Margin="0,18,0,8"/><TextBlock Text="Open a game → Options → Save Backups. Choose its save folder, make a snapshot, or preview a restore. Protected pre-restore snapshots stay until you remove them yourself." TextWrapping="Wrap"/><TextBlock Text="Archive Extraction" FontSize="18" Margin="0,24,0,8"/><TextBlock Text="Inspect contents before extracting. Queue jobs, cancel safely, and retry interrupted work from Activity." TextWrapping="Wrap"/><Button Content="Open Extraction Queue…" Tag="queue" Click="Route" HorizontalAlignment="Left" Margin="0,12"/><TextBlock Text="Start Fresh" FontSize="18" Margin="0,24,0,8"/><TextBlock Text="Clear game records, library folders and the extraction queue. Original games, archives, save files and backup snapshots stay on disk." TextWrapping="Wrap"/><Button Content="Purge Library…" Tag="purge" Click="Route" HorizontalAlignment="Left" Margin="0,12"/><TextBlock Text="Saved credentials live in Windows Credential Manager. ArcHive keeps no passwords or API keys in its library, settings files or logs. Browser sign-ins stay in your browser." TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,16"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Optional Sources"><StackPanel Margin="24"><TextBlock Text="Optional Sources" FontSize="22"/><CheckBox x:Name="F95Enabled" Content="Enable F95Zone Thread Tools" Margin="0,20,0,12"/><TextBlock Text="Adds explicit thread linking and public-page metadata checks to game options. No background browsing, browser-cookie access, or automatic downloads. A linked source never changes your metadata or latest version without review." TextWrapping="Wrap" Foreground="#8FAA99"/><TextBlock Text="F95Zone may require a browser login. Opening its website does not connect that browser session to ArcHive." TextWrapping="Wrap" Margin="0,14"/></StackPanel></TabItem>
   <TabItem Header="Integrations"><StackPanel Margin="24"><TextBlock Text="Integrations &amp; Plugins" FontSize="22"/><TextBlock Text="Configure Locale Emulator and explicitly installed metadata or launch plugins." TextWrapping="Wrap" Margin="0,12"/><Button Content="Manage Integrations…" Click="ManageIntegrations" HorizontalAlignment="Left"/></StackPanel></TabItem>
   <TabItem Header="Updates"><StackPanel Margin="24"><TextBlock Text="ArcHive Updates" FontSize="22"/><CheckBox x:Name="AutoUpdates" Content="Check for Updates at Startup" Margin="0,20,0,12"/><TextBlock Text="Checks published GitHub releases. Downloads and installation require your choice. Source commits are available after a packaged release is published." TextWrapping="Wrap" Foreground="#8FAA99"/><Button Content="Check for Updates..." Click="ShowUpdates" HorizontalAlignment="Left" Margin="0,16"/></StackPanel></TabItem>
   <TabItem Header="About ArcHive"><StackPanel Margin="24"><TextBlock Text="ArcHive" FontSize="28"/><TextBlock Text="{x:Static core:UiText.Tagline}" Margin="0,8,0,22" Foreground="#8FAA99"/><Button Content="About ArcHive" Click="ShowAbout" HorizontalAlignment="Left"/></StackPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
