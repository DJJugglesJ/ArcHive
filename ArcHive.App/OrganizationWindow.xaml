<Window Background="#080D0B" Foreground="#E1F0E6" FontFamily="Segoe UI" x:Class="ArcHive.App.OrganizationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArcHive.App" Title="Organize your library" Width="1200" Height="780" MinWidth="850" MinHeight="620" WindowStartupLocation="CenterOwner">
 <Window.Resources><local:CompactPathConverter x:Key="CompactPath"/>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#080D0B"/><Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="RowBackground" Value="#14231B"/><Setter Property="AlternatingRowBackground" Value="#102018"/><Setter Property="BorderBrush" Value="#234532"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#234532"/><Setter Property="Foreground" Value="#B3FFD0"/><Setter Property="Padding" Value="8"/></Style>
 </Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Organize your library" FontSize="26"/><TextBlock Text="Current view only. Select rows with Ctrl/Shift, or review a duplicate group. Original files are never removed." TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,8,0,12"/></StackPanel>
  <WrapPanel Grid.Row="1" x:Name="ScanControls"><Button Content="Select all shown" Click="SelectAll"/><Button Content="Clear selection" Click="ClearSelection"/><CheckBox x:Name="HashArchives" Content="Compare archive contents (SHA-256)" VerticalAlignment="Center"/><Button Content="Find duplicates" Click="FindDuplicates"/></WrapPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <DataGrid HeadersVisibility="Column" x:Name="Entries" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="SelectionChanged" AutomationProperties.Name="Entries for batch organization"><DataGrid.Columns><DataGridTextColumn Header="Game" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Progress}" Width="100"/><DataGridCheckBoxColumn Header="Favorite" Binding="{Binding Favorite}" Width="70"/><DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="*"/><DataGridTextColumn Header="Source path" Binding="{Binding SourceLocation, Converter={StaticResource CompactPath}}" Width="220"/></DataGrid.Columns></DataGrid>
   <Grid Grid.Column="1" Margin="16,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Duplicate evidence" Foreground="#B3FFD0"/><ListBox x:Name="Groups" Grid.Row="1" SelectionChanged="GroupSelected" AutomationProperties.Name="Duplicate groups"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="4,8"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBox Grid.Row="2" x:Name="Evidence" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Duplicate paths and warnings"/></Grid>
  </Grid>
  <WrapPanel Grid.Row="3" Margin="0,14,0,6" x:Name="ActionControls"><ComboBox x:Name="Action" Width="200" Margin="0,0,10,8" SelectionChanged="ActionChanged" AutomationProperties.Name="Batch action"/><ComboBox x:Name="ProgressStatus" Width="130" Margin="0,0,10,8" SelectionChanged="InvalidatePreview" AutomationProperties.Name="Batch status"/><TextBox x:Name="TagInput" Width="220" Margin="0,0,10,8" TextChanged="InvalidatePreview" ToolTip="Comma-separated tags" AutomationProperties.Name="Batch tags"/><Button x:Name="PreviewButton" Content="Preview changes" Click="Preview"/></WrapPanel>
  <DataGrid HeadersVisibility="Column" Grid.Row="4" x:Name="Changes" AutomationProperties.Name="Batch change preview"><DataGrid.Columns><DataGridTextColumn Header="Game" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="*"/><DataGridTextColumn Header="After" Binding="{Binding After}" Width="*"/></DataGrid.Columns></DataGrid>
  <DockPanel Grid.Row="5" Margin="0,12,0,0"><WrapPanel DockPanel.Dock="Right"><Button x:Name="ApplyButton" Content="Apply preview" Click="Apply" IsEnabled="False"/><Button x:Name="CancelScan" Content="Cancel scan" Click="Cancel" IsEnabled="False"/><Button Content="Close" Click="CloseWindow"/></WrapPanel><TextBlock x:Name="Summary" Text="Select entries to begin." TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
