<Window Background="#080D0B" Foreground="#E1F0E6" FontFamily="Segoe UI" x:Class="ArcHive.App.DetectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:ArcHive.Core;assembly=ArcHive.Core" xmlns:local="clr-namespace:ArcHive.App" Title="{x:Static core:UiText.ScanGameFiles}" Width="1000" Height="760" MinWidth="780" MinHeight="580" WindowStartupLocation="CenterOwner">
 <Window.Resources><local:CompactPathConverter x:Key="CompactPath"/></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="130"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{x:Static core:UiText.ScanGameFiles}" FontSize="26"/><TextBlock Text="Evidence from local files only. Nothing is executed. Existing profiles and defaults stay intact." TextWrapping="Wrap" Foreground="#8FAA99" Margin="0,8"/><TextBlock x:Name="Current" TextWrapping="Wrap"/></StackPanel>
  <DockPanel Grid.Row="1" Margin="0,12"><Button DockPanel.Dock="Right" x:Name="ScanButton" Content="{x:Static core:UiText.ScanGameFiles}" Click="Scan"/><ComboBox x:Name="Installations" AutomationProperties.Name="Installation to inspect" SelectionChanged="InstallationChanged"/></DockPanel>
  <DataGrid HeadersVisibility="Column" Grid.Row="2" x:Name="Candidates" SelectionChanged="CandidateChanged" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Background="#080D0B" Foreground="#E1F0E6" RowBackground="#14231B" AutomationProperties.Name="Launch suggestions"><DataGrid.Columns><DataGridTextColumn Header="Executable" Binding="{Binding Path, Converter={StaticResource CompactPath}}" Width="*"/><DataGridTextColumn Header="Engine hint" Binding="{Binding Engine}" Width="150"/><DataGridTextColumn Header="Evidence" Binding="{Binding EvidenceText}" Width="2*"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="3" Margin="0,14"><CheckBox x:Name="UseCandidate" Content="Add selected executable as a new profile (keep existing profiles/default)"/><CheckBox x:Name="UseEngine" Content="Apply selected engine suggestion (explicitly replaces current engine)"/><ComboBox x:Name="Engines" AutomationProperties.Name="Engine suggestion"/><CheckBox x:Name="UseTitle" Margin="0,12,0,4" Content="Apply suggested title from source path (explicitly replaces current title)"/><TextBlock x:Name="TitleSuggestion" TextWrapping="Wrap"/></StackPanel>
  <TextBox Grid.Row="4" x:Name="Evidence" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Detection notes and accepted evidence history"/>
  <DockPanel Grid.Row="5"><WrapPanel DockPanel.Dock="Right"><Button x:Name="ApplyButton" Content="Apply Selected Changes" Click="Apply" IsEnabled="False"/><Button Content="Cancel / close" Click="CloseWindow"/></WrapPanel><TextBlock x:Name="Status" Text="Choose an installation and scan. No choices are applied automatically." TextWrapping="Wrap"/></DockPanel>
 </Grid>
</Window>
