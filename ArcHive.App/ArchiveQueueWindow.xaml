<Window x:Class="ArcHive.App.ArchiveQueueWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Archives and extraction queue" Width="1050" Height="780" MinWidth="800" MinHeight="600" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#080D0B"/><Setter Property="Foreground" Value="#E1F0E6"/><Setter Property="RowBackground" Value="#14231B"/><Setter Property="AlternatingRowBackground" Value="#102018"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#234532"/><Setter Property="Foreground" Value="#B3FFD0"/><Setter Property="Padding" Value="8"/></Style>
 </Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="100"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Archives and extraction queue" FontSize="26"/><TextBlock x:Name="SourcePath" TextWrapping="Wrap" Margin="0,8" Foreground="#8FAA99"/></StackPanel>
  <WrapPanel Grid.Row="1" x:Name="PreviewControls"><Button x:Name="PreviewButton" Content="Preview contents" Click="Preview"/><Button x:Name="EnqueueButton" Content="Add to queue…" Click="Enqueue" IsEnabled="False"/><TextBlock x:Name="PreviewSummary" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel>
  <DataGrid Grid.Row="2" x:Name="Contents" AutomationProperties.Name="Archive contents"><DataGrid.Columns><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="100"/><DataGridCheckBoxColumn Header="Folder" Binding="{Binding Directory}" Width="65"/><DataGridTextColumn Header="Issue" Binding="{Binding Issue}" Width="240"/></DataGrid.Columns></DataGrid>
  <WrapPanel Grid.Row="3" x:Name="QueueControls" Margin="0,12,0,0"><Button Content="Run pending / finish linking" Click="Run"/><Button Content="Retry selected" Click="Retry"/><Button Content="Cancel pending entry" Click="CancelPending"/></WrapPanel>
  <DataGrid Grid.Row="4" x:Name="Jobs" SelectionChanged="SelectedJob" AutomationProperties.Name="Persistent extraction queue"><DataGrid.Columns><DataGridTextColumn Header="Game" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="Destination parent" Binding="{Binding Parent}" Width="*"/><DataGridTextColumn Header="Result / error" Binding="{Binding Error}" Width="*"/></DataGrid.Columns></DataGrid>
  <TextBox Grid.Row="5" x:Name="JobDetails" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Extraction output and retained attempt paths"/>
  <DockPanel Grid.Row="6"><WrapPanel DockPanel.Dock="Right"><Button x:Name="StopButton" Content="Stop" Click="Stop" IsEnabled="False"/><Button Content="Close" Click="CloseWindow"/></WrapPanel><TextBlock x:Name="Status" Text="Jobs persist across restarts. Interrupted jobs need Retry. Existing files are retained." TextWrapping="Wrap"/></DockPanel>
 </Grid>
</Window>
