<Window x:Class="ArcHive.App.MetadataWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Review game metadata" Width="850" Height="760" MinWidth="650" MinHeight="550" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="22">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Find the right game" FontSize="24"/>
   <TextBlock Text="Scores are similarity hints, not verified identities. Select a candidate and choose each field to replace." TextWrapping="Wrap" Margin="0,10"/>
   <TextBox x:Name="QueryBox" AutomationProperties.Name="Metadata search title"/>
   <StackPanel x:Name="SearchActions"><ComboBox x:Name="ProviderChoice" SelectedIndex="0" Margin="0,0,0,10" AutomationProperties.Name="Metadata provider" SelectionChanged="ProviderChanged"><ComboBoxItem Content="VNDB — title search"/><ComboBoxItem Content="Steam — catalog title matching"/><ComboBoxItem Content="IGDB — title search"/><ComboBoxItem Content="itch.io — my owned games"/><ComboBoxItem Content="itch.io — my projects"/><ComboBoxItem Content="RAWG — title search"/></ComboBox><WrapPanel><Button Content="Search selected provider" Click="SearchOnline"/><Button Content="Provider settings" Click="ConfigureProviders"/><Button Content="Import metadata JSON" Click="ImportOffline"/></WrapPanel></StackPanel>
   <TextBlock Text="Online search uses the selected service and configured credentials. Steam downloads its title catalog; itch.io reads your selected account scope and matches locally. First catalog lookups can take a few minutes. Offline import makes no requests." TextWrapping="Wrap" Foreground="#8FAA99"/>
   <TextBlock TextWrapping="Wrap">Metadata sources: <Hyperlink NavigateUri="https://store.steampowered.com/" RequestNavigate="OpenSource">Steam</Hyperlink> · <Hyperlink NavigateUri="https://www.igdb.com/" RequestNavigate="OpenSource">IGDB</Hyperlink> · <Hyperlink NavigateUri="https://itch.io/" RequestNavigate="OpenSource">itch.io</Hyperlink> · <Hyperlink NavigateUri="https://rawg.io/" RequestNavigate="OpenSource">RAWG</Hyperlink> · <Hyperlink NavigateUri="https://vndb.org/" RequestNavigate="OpenSource">VNDB</Hyperlink></TextBlock>
   <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,12"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="Unchecked fields keep their current value. Existing values are unchecked by default. Provider text is displayed as plain text." TextWrapping="Wrap" Margin="0,10"/><WrapPanel><Button x:Name="ApplyButton" Content="Apply selected changes" Click="Apply" IsEnabled="False"/><Button Content="Cancel" IsCancel="True"/></WrapPanel></StackPanel>
  <Grid><Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <ListBox x:Name="Candidates" SelectionChanged="SelectCandidate"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="5,8"/></DataTemplate></ListBox.ItemTemplate></ListBox>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="FieldRows"/></ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
