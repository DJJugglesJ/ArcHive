<Window Background="#080D0B" Foreground="#E1F0E6" FontFamily="Segoe UI" x:Class="ArcHive.App.MetadataWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:ArcHive.Core;assembly=ArcHive.Core" Title="{x:Static core:UiText.FindInformation}" Width="850" Height="760" MinWidth="650" MinHeight="550" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="22">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="{x:Static core:UiText.FindInformation}" FontSize="24"/>
   <TextBlock Text="{x:Static core:UiText.MatchingNotice}" TextWrapping="Wrap" Margin="0,10"/>
   <TextBox x:Name="QueryBox" TextChanged="SearchInputChanged" AutomationProperties.Name="Metadata search title"/>
   <StackPanel x:Name="SearchActions"><ComboBox x:Name="ProviderChoice" SelectedIndex="0" Margin="0,0,0,10" AutomationProperties.Name="Metadata provider" SelectionChanged="ProviderChanged"><ComboBoxItem Content="VNDB — title search"/><ComboBoxItem Content="Steam — catalog title matching"/><ComboBoxItem Content="IGDB — title search"/><ComboBoxItem Content="itch.io — my owned games"/><ComboBoxItem Content="itch.io — my projects"/><ComboBoxItem Content="RAWG — title search"/><ComboBoxItem x:Name="F95Choice" Content="F95Zone — public thread URL / ID" ToolTip="Enable F95Zone in Settings → Optional Sources."/></ComboBox><WrapPanel><Button Content="Search Provider" Click="SearchOnline"/><Button Content="Manage Connections" Click="ConfigureProviders"/><Button Content="Import Metadata from JSON" Click="ImportOffline"/></WrapPanel></StackPanel>
   <StackPanel x:Name="ThreadInput" Visibility="Collapsed"><TextBlock Text="F95Zone Thread URL or ID"/><TextBox x:Name="ThreadLink" TextChanged="SearchInputChanged" AutomationProperties.Name="F95Zone Thread URL or ID"/></StackPanel>
   <TextBlock x:Name="ProviderHint" TextWrapping="Wrap" Foreground="#8FAA99"/>

   <TextBlock TextWrapping="Wrap">Metadata sources: <Hyperlink NavigateUri="https://store.steampowered.com/" RequestNavigate="OpenSource">Steam</Hyperlink> · <Hyperlink NavigateUri="https://www.igdb.com/" RequestNavigate="OpenSource">IGDB</Hyperlink> · <Hyperlink NavigateUri="https://itch.io/" RequestNavigate="OpenSource">itch.io</Hyperlink> · <Hyperlink NavigateUri="https://rawg.io/" RequestNavigate="OpenSource">RAWG</Hyperlink> · <Hyperlink NavigateUri="https://vndb.org/" RequestNavigate="OpenSource">VNDB</Hyperlink></TextBlock>
   <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,12"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="Unchecked fields keep their current value. Existing values are unchecked by default. Provider text is displayed as plain text." TextWrapping="Wrap" Margin="0,10"/><WrapPanel><Button x:Name="ApplyButton" Content="{x:Static core:UiText.ApplyChanges}" Click="Apply" IsEnabled="False"/><Button Content="{x:Static core:UiText.Cancel}" IsCancel="True"/></WrapPanel></StackPanel>
  <Grid><Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <ListBox x:Name="Candidates" SelectionChanged="SelectCandidate"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="5,8"/></DataTemplate></ListBox.ItemTemplate></ListBox>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="FieldRows"/></ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
